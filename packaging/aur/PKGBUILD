# Maintainer: Plamen Petkov <info@x3me.net>
#
# Repackages the official release .deb rather than building from source,
# because the release artifacts carry the app's OAuth client credentials
# (embedded at release-build time; see docs/distribution.md §1). A source
# build would produce a binary that cannot sign in without the user creating
# their own Google Cloud project — the experience this package exists to
# remove.
pkgname=omacal
pkgver=0.20.0
pkgrel=1
pkgdesc="Minimalist open-source Google Calendar client, built for Omarchy"
arch=('x86_64')
url="https://extremelabs.io/omacal"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
optdepends=('gnome-keyring: Secret Service provider, required for sign-in token storage')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.deb::https://github.com/x3me/omacal/releases/download/v${pkgver}/omacal_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/x3me/omacal/v${pkgver}/LICENSE")
noextract=("${pkgname}-${pkgver}.deb")
sha256sums=('6d45253467db3283a82f69a0037c86ec8813f92153e5321df6d96a7e4a9ff682'
            '6d6c6bf89ad055436e423034485b18882a00ce3a1aa0464a3377d2f0c6d9f622')

package() {
  bsdtar -xOf "${srcdir}/${pkgname}-${pkgver}.deb" data.tar.gz | bsdtar -xzf - -C "${pkgdir}"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
